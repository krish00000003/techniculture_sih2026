# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vocational_tracker?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# Server Port
PORT=5000

# Client URL (for CORS and magic-link URLs)
CLIENT_URL=http://localhost:5173
